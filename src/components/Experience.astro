---
import { experience } from '../data/site';
---
<section id="experience" class="section">
  <div class="section-head reveal">
    <h2>Where I've worked</h2>
    <span class="label caps bracket">Experience</span>
  </div>

  <!-- Layout: vertical timeline with a rail that fills as you scroll -->
  <div class="timeline" data-timeline>
    <span class="rail" aria-hidden="true"><span class="fill"></span></span>
    <ol class="roles">
    {experience.map((r, i) => (
      <li class="role reveal">
        <span class="node" aria-hidden="true"></span>
        <div class="when">
          <span class="index">{String(experience.length - i).padStart(2, '0')}</span>
          <span class="caps period">{r.period}</span>
        </div>
        <article class="body">
          <h3>{r.title}</h3>
          <p class="company">{r.company} <span>· {r.place}</span></p>
          <p class="desc">{r.description}</p>
          <ul class="tags caps">{r.tags.map((t) => <li>{t}</li>)}</ul>
        </article>
      </li>
    ))}
    </ol>
  </div>
</section>

<style>
  .timeline { --progress: 0; position: relative; padding-left: 2.4rem; }
  .roles { list-style: none; }
  .rail { position: absolute; left: 0.45rem; top: 0.6rem; bottom: 0.6rem; width: 1px; background: var(--line); }
  .fill {
    position: absolute; inset: 0; transform-origin: top;
    transform: scaleY(var(--progress)); background: linear-gradient(var(--green), var(--blue), var(--violet));
  }
  .role {
    position: relative;
    display: grid; grid-template-columns: minmax(12rem, 0.4fr) 1fr; gap: 2rem;
    padding-bottom: clamp(3rem, 8vh, 5rem);
  }
  .node {
    position: absolute; left: calc(-2.4rem + 0.45rem - 5px); top: 0.55rem;
    width: 11px; height: 11px; border-radius: 50%;
    background: var(--bg); border: 1px solid var(--line-hi);
    transition: background 0.4s, border-color 0.4s, box-shadow 0.4s;
  }
  .role.lit .node { background: var(--green); border-color: var(--green); box-shadow: 0 0 14px var(--green); }
  .when { display: flex; flex-direction: column; gap: 0.6rem; }
  .index { font-size: clamp(3rem, 6vw, 5rem); font-weight: 200; line-height: 0.9; letter-spacing: -0.04em; color: var(--gray2); transition: color 0.4s; }
  .role.lit .index { color: var(--white); }
  .period { font-size: 0.85rem; color: var(--gray); }

  .body { padding: 1.8rem; border: 1px solid var(--line); background: var(--surface); }
  h3 { font-size: clamp(1.5rem, 2.4vw, 2.1rem); font-weight: 300; letter-spacing: -0.01em; line-height: 1.1; }
  .company { margin-top: 0.4rem; color: var(--white); }
  .company span { color: var(--gray); }
  .desc { margin-top: 1.2rem; color: rgba(242, 244, 247, 0.8); line-height: 1.65; max-width: 44em; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.4rem; list-style: none; }
  .tags li { font-size: 0.75rem; padding: 0.3rem 0.65rem; border: 1px solid var(--line); color: var(--gray); }

  @media (max-width: 760px) {
    .timeline { padding-left: 1.8rem; }
    .node { left: calc(-1.8rem + 0.45rem - 5px); }
    .role { grid-template-columns: 1fr; gap: 1rem; }
    .when { flex-direction: row; align-items: baseline; gap: 1rem; }
    .index { font-size: 2.4rem; }
    .body { padding: 1.3rem; }
  }
</style>

<script>
  const timeline = document.querySelector<HTMLElement>('[data-timeline]');
  if (timeline) {
    const roles = [...timeline.querySelectorAll<HTMLElement>('.role')];
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = timeline.getBoundingClientRect();
      const mid = innerHeight * 0.6;
      const p = Math.min(1, Math.max(0, (mid - r.top) / r.height));
      timeline.style.setProperty('--progress', p.toFixed(4));
      roles.forEach((role) => role.classList.toggle('lit', role.getBoundingClientRect().top < mid));
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>
