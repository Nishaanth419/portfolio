---
import { profile } from '../data/site';

const links = [
  { href: '#home', label: 'Home' },
  { href: '#about', label: 'About' },
  { href: '#experience', label: 'Experience' },
  { href: '#works', label: 'Works' },
];
---
<nav class="nav" data-nav>
  <a href="#home" class="logo"><svg class="asterisk" aria-hidden="true"><use href="#ast" /></svg>{profile.shortName}</a>
  <ul class="links" id="nav-links">
    {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    <li class="mobile-only"><a href="#contact">Contact</a></li>
  </ul>
  <a href="#contact" class="btn-ghost desktop-only">Contact Me</a>
  <button class="menu" type="button" aria-expanded="false" aria-controls="nav-links">
    <span class="sr-only">Menu</span><i></i><i></i>
  </button>
</nav>

<style>
  .nav {
    position: fixed; top: 0; left: 50%; transform: translateX(-50%); z-index: 50;
    width: min(1000px, calc(100% - 2 * var(--gutter)));
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.55rem 0.55rem 0.55rem 1rem;
    background: rgba(8, 9, 12, 0.78);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border: 1px solid rgba(255, 255, 255, 0.06); border-top: 0;
  }
  .logo { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; font-size: 1.05rem; font-weight: 400; }
  .logo .asterisk { width: 22px; height: 22px; transition: transform 0.8s var(--ease); }
  .logo:hover .asterisk { transform: rotate(180deg); }
  .links { display: flex; gap: 2.4rem; list-style: none; }
  .links a { text-decoration: none; color: var(--gray); font-size: 0.98rem; font-weight: 400; transition: color 0.2s; }
  .links a:hover, .links a.active { color: var(--white); }
  .mobile-only, .menu { display: none; }

  .menu {
    width: 2.6rem; height: 2.6rem; border: 1px solid var(--line-hi); background: none; cursor: pointer;
    flex-direction: column; align-items: center; justify-content: center; gap: 6px;
  }
  .menu i { display: block; width: 16px; height: 1px; background: var(--white); transition: transform 0.3s var(--ease); }
  .menu[aria-expanded='true'] i:first-of-type { transform: translateY(3.5px) rotate(45deg); }
  .menu[aria-expanded='true'] i:last-of-type { transform: translateY(-3.5px) rotate(-45deg); }

  @media (max-width: 900px) {
    .desktop-only { display: none; }
    .menu { display: flex; }
    .mobile-only { display: list-item; }
    .links {
      position: absolute; top: 100%; left: -1px; right: -1px;
      flex-direction: column; gap: 0; padding: 0.5rem 1rem 1rem;
      background: rgba(8, 9, 12, 0.96); border: 1px solid rgba(255, 255, 255, 0.06); border-top: 0;
      clip-path: inset(0 0 100% 0); transition: clip-path 0.45s var(--ease);
    }
    .links a { display: block; padding: 0.8rem 0; font-size: 1.6rem; font-weight: 300; color: var(--white); border-bottom: 1px solid var(--line); }
    .nav.open .links { clip-path: inset(0 0 0 0); }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const menu = nav.querySelector<HTMLButtonElement>('.menu')!;
  const setOpen = (open: boolean) => {
    nav.classList.toggle('open', open);
    menu.setAttribute('aria-expanded', String(open));
  };
  menu.addEventListener('click', () => setOpen(!nav.classList.contains('open')));
  nav.querySelectorAll('.links a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  // highlight the link for the section in the middle of the viewport
  const links = [...nav.querySelectorAll<HTMLAnchorElement>('.links a')];
  const obs = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) links.forEach((a) => a.classList.toggle('active', a.hash === `#${e.target.id}`));
    }
  }, { rootMargin: '-45% 0px -50% 0px' });
  document.querySelectorAll('main > [id], header[id]').forEach((s) => obs.observe(s));
</script>
