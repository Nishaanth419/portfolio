---
import { profile } from '../data/site';
---
<header id="home" class="hero">
  <p class="eyebrow caps"><span class="bracket">{profile.role}</span><span class="dot"></span>{profile.location}</p>
  <h1 class="title">
    <span class="line"><span>Nishaanth</span></span>
    <span class="line"><span class="grad-text">K N</span></span>
  </h1>

  <div class="spacer"></div>

  <div class="info">
    <p class="lead caps">I design LLM agents and RAG systems that keep working long after the demo.</p>
    <p class="side">Software Engineer at Tarka Labs. Before that, I built AI tools for engineering teams at Bosch.</p>
  </div>

  <div class="bottom">
    <div class="tags caps">
      <span class="bracket">AI Engineer</span><span class="dot"></span>
      <span class="bracket">LLM Agents</span><span class="dot"></span>
      <span class="bracket">RAG Systems</span>
    </div>
    <div class="cta">
      <a class="btn-solid" href={`mailto:${profile.email}?subject=Hello%20Nishaanth`}>Send Request</a>
      <a class="btn-icon" href="#works" aria-label="See my work"><svg class="asterisk"><use href="#ast" /></svg></a>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative; min-height: 100svh;
    display: flex; flex-direction: column;
    padding: 0 var(--gutter) var(--gutter);
  }
  .eyebrow {
    display: flex; align-items: center; gap: 1rem;
    margin-top: clamp(6.5rem, 14vh, 10rem);
    font-size: clamp(0.85rem, 1vw, 1rem); color: var(--gray);
    animation: fade 1.2s 0.3s both;
  }
  .title {
    margin-top: 1.2rem;
    font-size: clamp(4rem, 12.5vw, 13rem);
    font-weight: 300; line-height: 0.92; letter-spacing: -0.045em;
  }
  .line { display: block; overflow: hidden; padding-bottom: 0.08em; }
  .line > span { display: inline-block; transform: translateY(110%); animation: rise 1.2s var(--ease) forwards; }
  .line:nth-child(2) > span { animation-delay: 0.12s; }
  @keyframes rise { to { transform: none; } }

  .spacer { flex: 1; min-height: 3rem; }
  .info {
    display: grid; grid-template-columns: 1fr auto; gap: 2rem;
    padding-top: 2.6rem; border-top: 1px solid var(--line);
    animation: fade 1.4s 0.5s both;
  }
  .lead { font-size: clamp(0.95rem, 1.25vw, 1.2rem); max-width: 30em; line-height: 1.3; }
  .side { font-size: clamp(0.95rem, 1.2vw, 1.15rem); max-width: 22em; color: rgba(242, 244, 247, 0.88); line-height: 1.35; }
  .bottom {
    display: flex; justify-content: space-between; align-items: flex-end; gap: 1.5rem; flex-wrap: wrap;
    margin-top: clamp(3rem, 10vh, 7rem);
    animation: fade 1.4s 0.8s both;
  }
  .tags { display: flex; align-items: center; gap: 1.4rem; flex-wrap: wrap; font-size: clamp(0.9rem, 1.1vw, 1.12rem); }
  .dot { width: 4px; height: 4px; border-radius: 50%; background: var(--white); }
  @keyframes fade { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }

  @media (max-width: 900px) { .info { grid-template-columns: 1fr; } }
  @media (max-width: 560px) {
    .bottom { flex-direction: column; align-items: stretch; }
    .tags { gap: 0.8rem; font-size: 0.85rem; }
  }
</style>
