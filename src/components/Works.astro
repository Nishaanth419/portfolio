---
import { categories, langColors, profile, projects, repoUrl } from '../data/site';

const title = (p: (typeof projects)[number]) => p.title ?? p.repo;
---
<section id="works" class="section">
  <div class="section-head reveal">
    <h2>Things I've built</h2>
    <span class="label caps bracket">Agents &amp; RAG</span>
  </div>

  <!-- Layout: asymmetric bento with one large tile, one wide tile, then a row of singles -->
  <div class="bento">
    {projects.map((p, i) => (
      <a class={`tile t${i} reveal`} href={repoUrl(p)} target="_blank" rel="noopener" data-glow>
        <span class="orb" aria-hidden="true"></span>
        <div class="top caps">
          <span>{String(i + 1).padStart(2, '0')} · <span class="bracket">{categories[p.category]}</span></span>
          <span class="arrow" aria-hidden="true">↗</span>
        </div>
        <div class="main">
          <h3>{title(p)}</h3>
          <p>{p.description}</p>
        </div>
        <div class="foot">
          <ul class="stack caps">{p.stack.map((s) => <li>{s}</li>)}</ul>
          <span class="lang" style={`--c:${langColors[p.lang] ?? '#A3A8B3'}`}><i></i>{p.lang}</span>
        </div>
      </a>
    ))}
  </div>

  <div class="more">
    <a class="btn-ghost" href={`${profile.github}?tab=repositories`} target="_blank" rel="noopener">All repositories on GitHub</a>
  </div>
</section>

<style>
  .bento {
    display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: minmax(250px, auto);
    gap: 0.8rem;
  }
  .tile {
    --mx: 50%; --my: 50%;
    position: relative; overflow: hidden; isolation: isolate;
    display: flex; flex-direction: column; justify-content: space-between; gap: 1.6rem;
    padding: 1.6rem; border: 1px solid var(--line); background: var(--surface);
    text-decoration: none; transition: border-color 0.4s;
  }
  .tile:hover { border-color: var(--line-hi); }
  .tile::before {
    content: ''; position: absolute; inset: 0; z-index: -1; opacity: 0; transition: opacity 0.4s;
    background:
      radial-gradient(380px circle at var(--mx) var(--my), rgba(62, 240, 168, 0.14), transparent 45%),
      radial-gradient(520px circle at var(--mx) var(--my), rgba(180, 92, 255, 0.12), transparent 60%);
  }
  .tile:hover::before { opacity: 1; }
  .t0 { grid-column: span 2; grid-row: span 2; }
  .t1 { grid-column: span 2; }
  .orb {
    position: absolute; z-index: -2; border-radius: 50%; filter: blur(50px); opacity: 0.18;
    width: 50%; aspect-ratio: 1; right: -15%; bottom: -25%;
    background: conic-gradient(from 180deg, var(--green), var(--blue), var(--violet), var(--green));
    animation: orbit 16s linear infinite;
  }
  .t0 .orb { opacity: 0.5; width: 60%; }
  @keyframes orbit { to { transform: rotate(360deg); } }

  .top { display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--gray); }
  .arrow { font-size: 1.2rem; color: var(--gray2); transition: transform 0.35s var(--ease), color 0.35s; }
  .tile:hover .arrow { transform: translate(3px, -3px); color: var(--white); }
  h3 { font-size: clamp(1.5rem, 2.2vw, 2rem); font-weight: 300; line-height: 1.05; letter-spacing: -0.015em; }
  .t0 h3 { font-size: clamp(2.6rem, 5.5vw, 5.4rem); letter-spacing: -0.035em; background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .tile p { margin-top: 0.9rem; color: var(--gray); font-size: 0.95rem; line-height: 1.55; max-width: 34em; }
  .t0 p { font-size: clamp(1rem, 1.3vw, 1.2rem); color: rgba(242, 244, 247, 0.82); }
  .foot { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .stack { display: flex; flex-wrap: wrap; gap: 0.2rem 0.9rem; list-style: none; font-size: 0.75rem; color: var(--gray); }
  .lang { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.8rem; color: var(--gray); white-space: nowrap; }
  .lang i { width: 7px; height: 7px; border-radius: 50%; background: var(--c); box-shadow: 0 0 8px var(--c); }

  .more { display: flex; justify-content: flex-end; margin-top: 2rem; }

  @media (max-width: 1000px) {
    .bento { grid-template-columns: repeat(2, 1fr); }
    .t0 { grid-row: span 1; }
  }
  @media (max-width: 640px) {
    .bento { grid-template-columns: 1fr; grid-auto-rows: auto; }
    .t0, .t1 { grid-column: auto; }
  }
</style>

<script>
  // pointer-following glow on each tile
  document.querySelectorAll<HTMLElement>('[data-glow]').forEach((tile) => {
    tile.addEventListener('pointermove', (e) => {
      const r = tile.getBoundingClientRect();
      tile.style.setProperty('--mx', `${e.clientX - r.left}px`);
      tile.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });
</script>
