---
import { profile, projects, skills } from '../data/site';

const stats = [
  { value: projects.length, label: 'Projects shipped' },
  { value: projects.filter((p) => p.category === 'agents').length, label: 'AI agents built' },
  { value: projects.filter((p) => p.category === 'rag').length, label: 'RAG systems' },
];
---
<section id="about" class="section about">
  <!-- Layout: sticky identity card on the left, scrolling story on the right -->
  <aside class="card reveal">
    <svg class="spin" aria-hidden="true"><use href="#ast" /></svg>
    <div>
      <p class="label caps bracket">About</p>
      <h2>{profile.name}</h2>
    </div>
    <dl>
      <div><dt class="caps">Based in</dt><dd>{profile.location}</dd></div>
      <div><dt class="caps">Now</dt><dd>Software Engineer, Tarka Labs</dd></div>
      <div><dt class="caps">Studied</dt><dd>B.Tech CSE, Amrita Vishwa Vidyapeetham</dd></div>
      <div><dt class="caps">Local time</dt><dd data-clock>IST</dd></div>
    </dl>
  </aside>

  <div class="story">
    <p class="statement reveal">
      I turn language models into <span class="grad-text">dependable software</span>.
      Agents that pick the right tool, retrieval that cites its sources,{' '}
      <span class="dim">and pipelines that stay up when real users arrive.</span>
    </p>
    <p class="body reveal">
      Today I build AI features and backend systems at Tarka Labs in Chennai. Before that I spent
      time at Bosch, first as a machine learning intern and later shipping RAG systems and NLP tools on
      Azure. Away from the keyboard I travel solo, write long form, and train six days a week.
    </p>

    <ul class="stats reveal">
      {stats.map((s) => (
        <li>
          <span class="num" data-count={s.value}>{String(s.value).padStart(2, '0')}</span>
          <span class="caps">{s.label}</span>
        </li>
      ))}
    </ul>

    <div class="bento">
      {skills.map((s, i) => (
        <article class="tile reveal" style={`--d:${i * 80}ms`}>
          <header class="caps"><span>{String(i + 1).padStart(2, '0')}</span><span class="bracket">{s.group}</span></header>
          <ul>{s.items.map((item) => <li>{item}</li>)}</ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .about {
    display: grid; grid-template-columns: minmax(260px, 0.38fr) 1fr; gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .card {
    position: sticky; top: 6rem;
    display: flex; flex-direction: column; gap: 2rem;
    padding: 1.8rem; border: 1px solid var(--line); background: var(--surface);
  }
  .spin { width: 64px; height: 64px; color: var(--green); animation: spin 18s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .card .label { color: var(--gray); font-size: 0.85rem; margin-bottom: 0.4rem; }
  .card h2 { font-size: clamp(1.8rem, 2.6vw, 2.4rem); font-weight: 300; letter-spacing: -0.02em; line-height: 1.05; }
  dl { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  dl div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.75rem 0; border-bottom: 1px solid var(--line); font-size: 0.92rem; }
  dt { color: var(--gray2); font-size: 0.78rem; padding-top: 0.15rem; }
  dd { text-align: right; }

  .statement { font-size: clamp(1.6rem, 3.1vw, 2.9rem); line-height: 1.16; letter-spacing: -0.015em; }
  .statement .dim { color: var(--gray2); }
  .body { margin-top: 2rem; max-width: 38em; color: var(--gray); font-size: 1.05rem; line-height: 1.7; }

  .stats { display: grid; grid-template-columns: repeat(3, 1fr); list-style: none; margin-top: 3.5rem; border-top: 1px solid var(--line); }
  .stats li { display: flex; flex-direction: column; gap: 0.4rem; padding: 1.4rem 1rem 0 0; }
  .stats li + li { padding-left: 1.2rem; border-left: 1px solid var(--line); }
  .num { font-size: clamp(3rem, 6vw, 5.5rem); font-weight: 200; line-height: 1; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .stats .caps { font-size: 0.8rem; color: var(--gray); }

  .bento { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.8rem; margin-top: 3.5rem; }
  .tile {
    padding: 1.5rem; border: 1px solid var(--line); background: var(--surface);
    transition-delay: var(--d); transition-property: opacity, transform, border-color;
  }
  .tile:hover { border-color: var(--line-hi); }
  .tile:first-child, .tile:last-child { grid-column: span 2; }
  .tile:first-child ul, .tile:last-child ul { columns: 2; }
  .tile header { display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--gray); margin-bottom: 1.6rem; }
  .tile ul { list-style: none; font-size: 1.1rem; line-height: 1.9; }

  @media (max-width: 900px) {
    .about { grid-template-columns: 1fr; }
    .card { position: relative; top: 0; }
  }
  @media (max-width: 560px) {
    .bento { grid-template-columns: 1fr; }
    .tile:first-child, .tile:last-child { grid-column: auto; }
    .tile:first-child ul, .tile:last-child ul { columns: 1; }
    .stats li + li { padding-left: 0.8rem; }
  }
</style>

<script>
  import { profile } from '../data/site';

  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock) {
    const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: profile.timezone, timeZoneName: 'short' });
    const tick = () => { clock.textContent = fmt.format(new Date()); };
    tick();
    setInterval(tick, 30_000);
  }

  // count the stat numbers up when they scroll into view
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nums = document.querySelectorAll<HTMLElement>('[data-count]');
  const obs = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      obs.unobserve(e.target);
      const el = e.target as HTMLElement;
      const target = Number(el.dataset.count);
      if (reduce) continue;
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / 1400);
        el.textContent = String(Math.round(target * (1 - Math.pow(1 - t, 3)))).padStart(2, '0');
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }
  }, { threshold: 0.6 });
  nums.forEach((n) => obs.observe(n));
</script>
